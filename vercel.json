{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "functions": {
    "api/entry.mjs": {
      "excludeFiles": "{data/openclaw-hidden-feed.json,data/tmp-*.json,data/tmp-*.ndjson,data/manual-*-batch*.json,data/openclaw-batch-*.json,test/**}"
    }
  },
  "crons": [
    {
      "path": "/api/openclaw/cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/social/autopilot/cron",
      "schedule": "0 */3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/entry?route=/"
    },
    {
      "source": "/(.*)",
      "destination": "/api/entry?route=/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-read=(), clipboard-write=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
